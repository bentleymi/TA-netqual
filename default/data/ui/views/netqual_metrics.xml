<dashboard version="1.1" theme="light">
  <label>TA-netqual Metrics</label>
  <description> Index-time metrics over index=metrics (sourcetype netqual:metrics); series prefixed 'netqual.'.</description>
  <row>
    <panel>
      <title>Carrier (per host+interface, 1=up)</title>
      <chart>
        <search>
          <query>| mstats avg("netqual.*_carrier") as "v*" where index=metrics by host, metric_name span=5m
| rename v* as "netqual.*_carrier"</query>
          <done/>
        </search>
        <option name="charting.chart">line</option>
        <option name="charting.chart.nullValueRendering">connect</option>
        <option name="charting.drilldown">none</option>
      </chart>
    </panel>
  </row>
  <row>
    <panel>
      <title>Negotiated speed (Mb/s per host+interface)</title>
