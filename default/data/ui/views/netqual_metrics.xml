<dashboard version="1.1" theme="light">
  <label>TA-netqual Metrics</label>
  <description> Index-time metrics over index=metrics (sourcetype netqual:metrics); series prefixed 'netqual.'.</description>
  <row>
    <panel>
      <title>Commercial use of TA-netqual requires a paid license (evaluation, personal, lab use free)</title>
      <table>
        <search><query>| makeresults | eval buy="Buy License at bentleypc.com/TA-netqual", terms="License and Terms at bentleypc.com/TA-netqual/LICENSE.html" | fields buy terms</query></search>
        <option name="drilldown">cell</option>
        <option name="rowNumbers">false</option>
        <option name="count">0</option>
        <drilldown>
          <condition field="buy"><link target="_blank">/static/app/TA-netqual/buy_license_netqual_metrics.html</link></condition>
          <condition field="terms"><link target="_blank">/static/app/TA-netqual/buy_terms_netqual_metrics.html</link></condition>
        </drilldown>
      </table>
    </panel>
  </row>
  <row>
    <panel>
      <title>Carrier (per host+interface, 1=up)</title>
      <chart>
        <search>
          <query>| mstats avg("netqual.*_carrier") as "v*" where index=metrics by host, metric_name span=5m
| rename v* as "netqual.*_carrier"</query>
          <done/>
        </search>
        <option name="charting.chart">line</option>
        <option name="charting.chart.nullValueRendering">connect</option>
        <option name="charting.drilldown">none</option>
      </chart>
    </panel>
  </row>
  <row>
    <panel>
      <title>Negotiated speed (Mb/s per host+interface)</title>
      <chart>
        <search>
          <query>| mstats avg("netqual.*_speed_mbps") as "v*" where index=metrics by host, metric_name span=5m
| rename v* as "netqual.*_speed_mbps"</query>
