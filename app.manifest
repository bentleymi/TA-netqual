{
  "schemaVersion": "2.0.0",
  "info": {
    "title": "Network Link Quality Add-on (carrier, speed, errors, drops)",
    "id": {
      "group": null,
      "name": "TA-netqual",
      "version": "1.0.0"
    },
    "author": [{"name":"Michael \"JKat54\" Bentley","email":"michael@bentleypc.com","company":"BentleyPC LLC"}],
    "releaseDate": "11/14/2026",
    "description": "Collects per-interface link quality from /sys/class/net and /proc/net/dev: carrier/operstate, negotiated speed, MTU, cumulative RX/TX error and drop counters per physical interface (virtual/veth/lo excluded). Emits JSON events to index=main (sourcetype netqual:status) and netqual.<iface>_* metrics to index=metrics (sourcetype netqual:metrics) at 60s cadence, with dashboards.",
